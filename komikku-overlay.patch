 }
 
 class LibraryUpdateStatus : BannerProgressStatus()
 class SyncStatus : BannerProgressStatus()
 class BackupRestoreStatus : BannerProgressStatus()
+
+data class BatchImportSnapshot(
+    val total: Int = 0,
+    val completed: Int = 0,
+    val added: Int = 0,
+    val failed: Int = 0,
+    val currentUrl: String = "",
+    val events: List<String> = emptyList(),
+    val running: Boolean = false,
+)
+
+class BatchImportStatus : BannerProgressStatus() {
+    val state = MutableStateFlow(BatchImportSnapshot())
+
+    fun begin(total: Int, completed: Int = 0, added: Int = 0, failed: Int = 0, events: List<String> = emptyList()) {
+        state.value = BatchImportSnapshot(
+            total = total,
+            completed = completed,
+            added = added,
+            failed = failed,
+            events = events,
+            running = true,
+        )
+        start()
+        updateProgress(if (total == 0) 0f else completed.toFloat() / total)
+    }
+
+    fun record(url: String, wasAdded: Boolean, detail: String? = null) {
+        val old = state.value
+        val event = if (wasAdded) {
+            "[ADDED] $url"
+        } else {
+            "[FAILED] $url${detail?.takeIf { it.isNotBlank() }?.let { " — $it" } ?: ""}"
+        }
+        val completed = old.completed + 1
+        val failed = old.failed + if (wasAdded) 0 else 1
+        state.value = old.copy(
+            completed = completed,
+            added = old.added + if (wasAdded) 1 else 0,
+            failed = failed,
+            currentUrl = url,
+            events = old.events + event,
+        )
+        updateProgress(if (old.total == 0) 0f else completed.toFloat() / old.total)
+    }
+
+    fun restore(total: Int, completed: Int, added: Int, failed: Int, events: List<String>, running: Boolean) {
+        state.value = BatchImportSnapshot(total, completed, added, failed, events = events, running = running)
+        updateProgress(if (total == 0) 0f else completed.toFloat() / total)
+        if (running) start() else stop()
+    }
+}
