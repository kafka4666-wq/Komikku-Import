[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    private suspend fun fetchGalleryDetails([m
[32m+[m[32m        client: okhttp3.OkHttpClient,[m
[32m+[m[32m        id: Long,[m
[32m+[m[32m        awaitRequestSlot: suspend () -> Unit,[m
[32m+[m[32m    ): JSONObject? {[m
[32m+[m[32m        repeat(3) { attempt ->[m
[32m+[m[32m            awaitRequestSlot()[m
[32m+[m[32m            val response = client.newCall(GET("https://nhentai.net/api/v2/galleries/$id".toHttpUrl())).execute()[m
