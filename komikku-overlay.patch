[32m+[m[32m                val tags = details.optJSONArray("tags")[m
[32m+[m[32m                val hasExcludedTag = excludedTags.any { excluded ->[m
[32m+[m[32m                    (0 until (tags?.length() ?: 0)).any { tagIndex ->[m
[32m+[m[32m                        tags?.optJSONObject(tagIndex)?.optString("name").equals(excluded, ignoreCase = true)[m
[32m+[m[32m                    }[m
[32m+[m[32m                }[m
[32m+[m[32m                if (!hasExcludedTag && uploaded in start.time..(end.time + DAY_MS - 1L)) {[m
[32m+[m[32m                    all += "https://nhentai.net/g/$id/"[m
[32m+[m[32m                }[m
