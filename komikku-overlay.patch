[32m+[m[32m                response.code == 404 -> { response.close(); return null }[m
[32m+[m[32m                response.code == 429 -> {[m
[32m+[m[32m                    response.close()[m
[32m+[m[32m                    delay((60_000L shl attempt).coerceAtMost(600_000L))[m
[32m+[m[32m                }[m
[32m+[m[32m                response.isSuccessful -> return JSONObject(response.use { it.body.string() })[m
[32m+[m[32m                else -> response.close()[m
