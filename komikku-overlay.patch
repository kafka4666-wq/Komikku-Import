+class NhentaiDateImportScreen : cafe.adriel.voyager.core.screen.Screen() {
+    @Composable
+    override fun Content() {
+        val context = LocalContext.current
+        var selectedDate by remember { mutableStateOf(today()) }
+        var started by remember { mutableStateOf(false) }
+
+        Scaffold { contentPadding ->
+            Column(
+                modifier = Modifier.padding(contentPadding).padding(24.dp),
+                verticalArrangement = Arrangement.spacedBy(16.dp),
+            ) {
+                Text("nhentai Books Imported", style = MaterialTheme.typography.titleLarge)
+                Text(
+                    "Import every nhentai(all) book uploaded on a specific date. Requests run in the background with the same safe pacing as Batch Add.",
+                    style = MaterialTheme.typography.bodyMedium,
+                )
+                Text("Selected date: $selectedDate", style = MaterialTheme.typography.titleMedium)
+                Row(
