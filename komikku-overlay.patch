[32m+[m[32m            val query = "Uploaded:>${lowerBoundDays}d $tagQuery".trim()[m
[32m+[m[32m            val url = "https://nhentai.net/api/v2/search".toHttpUrl().newBuilder()[m
[32m+[m[32m                .addQueryParameter("query", query)[m
[32m+[m[32m                .addQueryParameter("sort", "date")[m
[32m+[m[32m                .addQueryParameter("page", page.toString())[m
